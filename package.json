{
  "name": "dsh-custom-ui-theme",
  "version": "2.7.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaopengpian/dsh-custom-ui-theme.git"
  },
  "homepage": "https://github.com/gaopengpian/dsh-custom-ui-theme#readme",
  "bugs": "https://github.com/gaopengpian/dsh-custom-ui-theme/issues",
  "keywords": ["dsh-plugin", "deepseek-harness", "theme", "ui-customization", "color", "font"],
  "author": "gaopengpian",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
